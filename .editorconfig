# spec-0.1 D5：三语言缩进/换行基线（格式化细则归 spec-0.2 工具）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
