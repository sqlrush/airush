# connector 配置项（spec-0.7 D3；与 cmd/connector appConfig 同步，CI 校验一致性）
AIRUSH_CONNECTOR_LOG_LEVEL=info
# 配置/凭据目录（默认 ~/.airush-connector；私钥仅存客户侧 0600）
AIRUSH_CONNECTOR_CONFIG_DIR=
# 接入网关地址（--enroll/--run 必需）
AIRUSH_CONNECTOR_GATEWAY_ADDR=
# 一次性注册令牌（secret；仅 --enroll 需要）
AIRUSH_CONNECTOR_ENROLL_TOKEN=
# 注册端 server-TLS 信任根 PEM（空=系统根）
AIRUSH_CONNECTOR_ENROLL_CA_PEM=
