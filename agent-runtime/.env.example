# agent-runtime 配置项（spec-1.8 §2.6；与 cmd/agent-runtime appConfig 同步，CI 校验一致性）
# 组件段 = AGENT（AIRUSH_AGENT_*）；观测三件套走 AIRUSH_COMMON_* 回退
AIRUSH_AGENT_LOG_LEVEL=info
AIRUSH_AGENT_LISTEN_ADDR=:8082
AIRUSH_AGENT_OTLP_ENDPOINT=
AIRUSH_AGENT_TRACE_SAMPLE_RATIO=1.0
# 控制面 PG（同库；租户事务 SET LOCAL ROLE airush_app）——secret，勿写真实值
AIRUSH_AGENT_DB_URL=
# LLM 网关（spec-1.7）：OpenAI 兼容根 + 网关 master key（secret）
AIRUSH_AGENT_LLM_URL=http://localhost:4000/v1
AIRUSH_AGENT_LLM_KEY=
# 控制面内部 API（配额门 / 记账）+ 服务间 token（secret；同时是本进程内部 API 的口令）
AIRUSH_AGENT_CONSOLE_URL=http://localhost:8080
AIRUSH_AGENT_SVC_TOKEN=
AIRUSH_AGENT_DEFAULT_MODEL=chat-default
AIRUSH_AGENT_MAX_CONCURRENT_TURNS=8
AIRUSH_AGENT_DRAIN_TIMEOUT=300s
# 静态 skill MCP endpoints：逗号分隔 name=url（streamable HTTP）；spec-1.9 换注册表
AIRUSH_AGENT_MCP_ENDPOINTS=
AIRUSH_AGENT_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
