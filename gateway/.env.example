# gateway 配置项（spec-0.7 D3；与 cmd/gateway appConfig 同步，CI 校验一致性）
AIRUSH_GATEWAY_LOG_LEVEL=info
AIRUSH_GATEWAY_LISTEN_ADDR=:8081
# OTLP HTTP 端点（空=纯日志模式；本地观测栈 make obs-up 后填 localhost:4318；
# 可用 AIRUSH_COMMON_OTLP_ENDPOINT 全局设置）
AIRUSH_GATEWAY_OTLP_ENDPOINT=
# trace 采样率 [0,1]（dev 默认全采；可用 AIRUSH_COMMON_TRACE_SAMPLE_RATIO 全局设置）
AIRUSH_GATEWAY_TRACE_SAMPLE_RATIO=1.0
