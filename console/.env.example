# console 配置项（spec-0.7 D3；与 cmd/console appConfig 同步，CI 校验一致性）
# 复制为 .env 本地生效（.env 已 gitignore；生产不加载 .env）

# 日志级别：debug/info/warn/error（可用 AIRUSH_COMMON_LOG_LEVEL 全局设置）
AIRUSH_CONSOLE_LOG_LEVEL=info
# API 监听地址
AIRUSH_CONSOLE_LISTEN_ADDR=:8080
# OTLP collector 端点（可用 AIRUSH_COMMON_OTLP_ENDPOINT 全局设置；空 = 纯日志模式）
AIRUSH_CONSOLE_OTLP_ENDPOINT=
# trace 采样率 0..1（可用 AIRUSH_COMMON_TRACE_SAMPLE_RATIO 全局设置）
AIRUSH_CONSOLE_TRACE_SAMPLE_RATIO=1.0
# 控制面 PG 连接串（secret；migrate 与 --serve 必需）
AIRUSH_CONSOLE_DB_URL=postgres://postgres:CHANGE_ME@localhost:5432/airush?sslmode=disable
# 直连凭据信封加密 KEK（secret；base64 32B；--serve 必需。生成：openssl rand -base64 32）
AIRUSH_CONSOLE_CREDENTIAL_KEK=CHANGE_ME_BASE64_32B
# KEK 版本标识（轮换时递增，落 datasource_credentials.key_id）
AIRUSH_CONSOLE_CREDENTIAL_KEK_ID=v1
# Stage 1 默认租户（spec-2.2 认证接管后废弃；默认 = 迁移 seed 的 dev 租户）
AIRUSH_CONSOLE_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
# 服务间认证 token（secret；--serve 必需；gateway 调 /internal/v1/* 使用同值）
AIRUSH_CONSOLE_SVC_TOKEN=CHANGE_ME
# Connector 内部 CA（secret；--serve 必需；`console pki-init` 一次性生成后入 k8s Secret）
AIRUSH_CONSOLE_CA_CERT=CHANGE_ME_PEM
AIRUSH_CONSOLE_CA_KEY=CHANGE_ME_PEM
# 直连接入器连接池（spec-1.17）：空闲回收/建连超时/池上限（留空用默认 10m/8s/4）
AIRUSH_CONSOLE_DIRECT_IDLE_TTL=10m
AIRUSH_CONSOLE_DIRECT_CONNECT_TIMEOUT=8s
# 指标采集（spec-1.3）：gateway 内部采集 API 地址（空 = 只跑 Direct 通道，Connector 数据源跳过）
AIRUSH_CONSOLE_GATEWAY_URL=
# 采集间隔：指标 15s..3600s（下限 15s）；快照分 kind（spec-1.4，下限 60s/300s）
AIRUSH_CONSOLE_META_INTERVAL=3600s
AIRUSH_CONSOLE_METRICS_INTERVAL=60s
AIRUSH_CONSOLE_SLOWLOG_INTERVAL=300s
# 时序落库（spec-1.5）：单次写入行数上限，超出分批（同一事务内）
AIRUSH_CONSOLE_TS_BATCH_MAX_ROWS=5000
# LLM 网关配额（spec-1.7）：默认租户的月度 token 预算（启动时无配额行则写入；已有不覆盖）
AIRUSH_CONSOLE_LLM_DEFAULT_TOKEN_BUDGET=50000000
