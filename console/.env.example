# console 配置项（spec-0.7 D3；与 cmd/console appConfig 同步，CI 校验一致性）
# 复制为 .env 本地生效（.env 已 gitignore；生产不加载 .env）

# 日志级别：debug/info/warn/error（可用 AIRUSH_COMMON_LOG_LEVEL 全局设置）
AIRUSH_CONSOLE_LOG_LEVEL=info
# API 监听地址
AIRUSH_CONSOLE_LISTEN_ADDR=:8080
# 控制面 PG 连接串（secret；migrate 子命令必需）
AIRUSH_CONSOLE_DB_URL=postgres://postgres:CHANGE_ME@localhost:5432/airush?sslmode=disable
